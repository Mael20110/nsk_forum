body{
  background:black;
  color:white;
  font-family:Arial;
  display:flex;
  justify-content:center;
  align-items:center;
  height:100vh;
}

.container{
  background:#111;
  padding:30px;
  border-radius:15px;
  width:350px;
}

h1{
  text-align:center;
}

input, textarea{
  width:100%;
  margin-top:10px;
  padding:10px;
  border:none;
  border-radius:10px;
}

button{
  width:100%;
  padding:12px;
  margin-top:15px;
  background:white;
  color:black;
  border:none;
  border-radius:10px;
  cursor:pointer;
  font-weight:bold;
}

button:hover{
  background:gray;
}
