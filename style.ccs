body{
  margin:0;
  font-family: Arial, sans-serif;
  background: radial-gradient(circle at top, #1a1a1a, #000);
  color:white;
}

/* container */
.container{
  max-width:520px;
  margin:40px auto;
  background:#0f0f0f;
  padding:25px;
  border-radius:16px;
  box-shadow:0 0 25px rgba(255,255,255,0.05);
}

/* titre */
h1{
  text-align:center;
}

/* inputs */
input, textarea{
  width:100%;
  margin-top:12px;
  padding:12px;
  border-radius:10px;
  border:1px solid #333;
  background:#111;
  color:white;
}

/* bouton */
button{
  width:100%;
  margin-top:15px;
  padding:12px;
  border:none;
  border-radius:10px;
  background:white;
  color:black;
  font-weight:bold;
  cursor:pointer;
}

button:hover{
  background:#ddd;
}

/* message status */
#status{
  text-align:center;
  margin-top:10px;
  font-size:14px;
  opacity:0.8;
}

/* admin box */
.box{
  background:#111;
  border:1px solid #222;
  padding:15px;
  margin-top:15px;
  border-radius:14px;
}

/* textarea admin */
.box textarea{
  width:100%;
  height:60px;
  margin-top:10px;
  border-radius:10px;
  background:#0b0b0b;
  color:white;
  border:1px solid #333;
}

/* status */
.status{
  font-size:12px;
  padding:4px 10px;
  border-radius:20px;
  display:inline-block;
  margin:5px 0;
}

.pending{
  background:#ffcc00;
  color:black;
}

.answered{
  background:#00ff88;
  color:black;
}
